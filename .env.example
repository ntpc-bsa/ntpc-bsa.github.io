# 複製成 .env 後填入實際值。.env 不會進版控。
# 專案 ID 在 https://sanity.io/manage 該專案的首頁可以看到。
SANITY_PROJECT_ID=
SANITY_DATASET=production

# 只有在 dataset 設為私有時才需要；公開 dataset 留空即可。
SANITY_READ_TOKEN=

# 只有執行 scripts/migrate-to-sanity.mjs 搬遷時需要（Editor 權限）。
# 用完就到 sanity.io/manage → API → Tokens 撤銷，不要留著。
SANITY_WRITE_TOKEN=
